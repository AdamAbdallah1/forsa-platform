rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function verifiedUser() {
      return signedIn() &&
        request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return signedIn() &&
        get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.role == "admin";
    }

    // External applications must carry a valid destination type and a
    // corresponding non-empty destination. Legacy documents without an
    // application method (or without externalApplicationType) are allowed,
    // so the guard only binds new writes of the destination fields.
    function hasValidExternalApplication(data) {
      return (
        !data.keys().hasAny(["applicationMethod"]) ||
        data.applicationMethod != "external"
      )
        ? true
        : (
            !(data.externalApplicationType in ["url", "email"])
              ? false
              : (
                  data.externalApplicationType == "url"
                    ? (data.applicationUrl is string &&
                       data.applicationUrl.size() > 0)
                    : (data.applicationEmail is string &&
                       data.applicationEmail.size() > 0)
                )
          );
    }

    // Public profile projection: an explicitly whitelisted, intentionally
  // public mirror of a user's profile. Maintained by syncPublicProfile()
  // on login/profile-save from the user's OWN private document. The
  // document may never carry sensitive fields, and seeker documents may
  // never carry email/company fields.
  function publicProfileSafe(data) {
    return !data.keys().hasAny([
      "phone",
      "cv",
      "publicCv",
      "emailVerified",
      "role",
      "trusted",
      "verified",
      "isNewRegistration",
      "welcomeEmailSentAt",
      "profileCompleteEmailSentAt",
      "profileImprovementEmailSentAt",
      "onboardingCompletedAt"
    ]);
  }

  function seekerProfileSafe(data) {
    return data.accountType != "finder" ||
      !data.keys().hasAny([
        "email",
        "companyEmail"
      ]);
  }

  match /users/{userId} {
  // Users may only read their own private document. Admins retain full
  // read access. All other-user reads go through the intentionally-public
  // publicProfiles/{uid} projection below, which never carries private
  // fields (email, phone, CV URLs, administrative data).
  allow read: if signedIn() && request.auth.uid == userId;

  allow read: if isAdmin();

  allow create: if signedIn() &&
    request.auth.uid == userId &&
    request.resource.data.uid == userId &&
    request.resource.data.emailVerified ==
      request.auth.token.email_verified &&
    (
      !request.resource.data.keys().hasAny(["role"]) ||
      request.resource.data.role != "admin"
    );

  // Normal user profile edits.
  // Protected fields cannot be changed by the user.
  allow update: if signedIn() &&
    request.auth.uid == userId &&
    !request.resource.data.diff(resource.data)
      .affectedKeys()
      .hasAny([
        "uid",
        "role",
        "accountType",
        "trusted",
        "verified",
        "emailVerified",
        "email",
        "createdAt",
        "isNewRegistration",
        "username",
        "usernameLower",
        "welcomeEmailSentAt",
        "onboardingCompletedAt",
        "profileCompleteEmailSentAt",
        "profileImprovementEmailSentAt"
      ]);

  // User is allowed to synchronize email verification
  // after Firebase Auth confirms the email.
  allow update: if signedIn() &&
    request.auth.uid == userId &&
    request.resource.data.emailVerified == true &&
    request.auth.token.email_verified == true &&
    request.resource.data.diff(resource.data)
      .affectedKeys()
      .hasOnly([
        "emailVerified",
        "updatedAt"
      ]);

  // User is allowed to change their own public username.
  //
  // Uniqueness is guaranteed by the create-only `usernames` mapping that
  // the client claims (committed) before this profile update. This rule
  // binds that mapping to this user and enforces the same format and
  // lowercasing rules as registration.
  allow update: if signedIn() &&
    request.auth.uid == userId &&
    request.resource.data.diff(resource.data)
      .affectedKeys()
      .hasOnly([
        "username",
        "usernameLower",
        "updatedAt"
      ]) &&
    request.resource.data.username is string &&
    request.resource.data.username.size() >= 3 &&
    request.resource.data.username.size() <= 20 &&
    request.resource.data.username.matches('^[a-zA-Z0-9_]+$') &&
    request.resource.data.usernameLower ==
      request.resource.data.username.lower() &&
    (
      // Arrange-only (display casing) change of an existing username.
      resource.data.usernameLower ==
        request.resource.data.usernameLower ||
      // New mapping claimed in a prior committed write by this user.
      get(
        /databases/$(database)/documents/usernames/$(request.resource.data.usernameLower)
      ).data.uid == request.auth.uid
    );

  // Admin can update the user.
  allow update: if isAdmin();

  allow delete: if signedIn() &&
    request.auth.uid == userId;
}

    match /publicProfiles/{uid} {
      allow read: if true;

      allow create, update: if signedIn() &&
        request.auth.uid == uid &&
        publicProfileSafe(request.resource.data) &&
        seekerProfileSafe(request.resource.data);

      allow delete: if signedIn() &&
        request.auth.uid == uid;

      allow create, update, delete: if isAdmin();
    }

    // Unique username mapping: one document per lowercased username.
    // Created atomically with the user profile during registration.
    // `create` is rejected by Firestore if the document already exists,
    // which is what guarantees a username can never be claimed twice.
    match /usernames/{usernameLower} {
      allow read: if signedIn();

      allow create: if signedIn() &&
        request.resource.data.uid == request.auth.uid;

      // Users may only release their own mapping (e.g. account deletion).
      allow delete: if signedIn() &&
        resource.data.uid == request.auth.uid;
    }

    match /connections/{connectionId} {
      allow read: if signedIn();

      allow create: if signedIn() &&
        request.resource.data.fromUid == request.auth.uid;

      allow update: if signedIn() &&
        resource.data.toUid == request.auth.uid;

      allow delete: if signedIn() &&
        (
          resource.data.fromUid == request.auth.uid ||
          resource.data.toUid == request.auth.uid ||
          isAdmin()
        );
    }

    match /notifications/{notificationId} {
      // New application: only the applicant can notify the job owner.
      allow create: if signedIn() &&
        request.resource.data.type == "new_application" &&
        request.resource.data.applicationId != null &&
        get(
          /databases/$(database)/documents/applications/$(request.resource.data.applicationId)
        ).data.seeker.uid == request.auth.uid &&
        request.resource.data.targetUid ==
          get(
            /databases/$(database)/documents/applications/$(request.resource.data.applicationId)
          ).data.ownerUid &&
        request.resource.data.targetEmail ==
          get(
            /databases/$(database)/documents/applications/$(request.resource.data.applicationId)
          ).data.ownerEmail;

      // Application messages: only an application participant can notify
      // the other participant.
      allow create: if signedIn() &&
        request.resource.data.type == "new_message" &&
        request.resource.data.applicationId != null &&
        (
          (
            get(
              /databases/$(database)/documents/applications/$(request.resource.data.applicationId)
            ).data.seeker.uid == request.auth.uid &&
            request.resource.data.targetUid ==
              get(
                /databases/$(database)/documents/applications/$(request.resource.data.applicationId)
              ).data.ownerUid &&
            request.resource.data.targetEmail ==
              get(
                /databases/$(database)/documents/applications/$(request.resource.data.applicationId)
              ).data.ownerEmail
          ) ||
          (
            get(
              /databases/$(database)/documents/applications/$(request.resource.data.applicationId)
            ).data.ownerUid == request.auth.uid &&
            request.resource.data.targetUid ==
              get(
                /databases/$(database)/documents/applications/$(request.resource.data.applicationId)
              ).data.seeker.uid &&
            request.resource.data.targetEmail ==
              get(
                /databases/$(database)/documents/applications/$(request.resource.data.applicationId)
              ).data.seeker.email
          )
        );

      // Employer-generated application status/interview notifications.
      allow create: if signedIn() &&
        request.resource.data.type in [
          "application_status",
          "interview_invite",
          "interview_cancelled"
        ] &&
        request.resource.data.applicationId != null &&
        get(
          /databases/$(database)/documents/applications/$(request.resource.data.applicationId)
        ).data.ownerUid == request.auth.uid &&
        request.resource.data.targetUid ==
          get(
            /databases/$(database)/documents/applications/$(request.resource.data.applicationId)
          ).data.seeker.uid &&
        request.resource.data.targetEmail ==
          get(
            /databases/$(database)/documents/applications/$(request.resource.data.applicationId)
          ).data.seeker.email;

      // Connection request: only the requester can notify the recipient.
      allow create: if signedIn() &&
        request.resource.data.type == "connection_request" &&
        request.resource.data.connectionId != null &&
        get(
          /databases/$(database)/documents/connections/$(request.resource.data.connectionId)
        ).data.fromUid == request.auth.uid &&
        request.resource.data.targetUid ==
          get(
            /databases/$(database)/documents/connections/$(request.resource.data.connectionId)
          ).data.toUid &&
        request.resource.data.targetEmail ==
          get(
            /databases/$(database)/documents/connections/$(request.resource.data.connectionId)
          ).data.toEmail;

      // Connection accepted: only the recipient can notify the original requester.
      allow create: if signedIn() &&
        request.resource.data.type == "connection_accepted" &&
        request.resource.data.connectionId != null &&
        get(
          /databases/$(database)/documents/connections/$(request.resource.data.connectionId)
        ).data.toUid == request.auth.uid &&
        request.resource.data.targetUid ==
          get(
            /databases/$(database)/documents/connections/$(request.resource.data.connectionId)
          ).data.fromUid &&
        request.resource.data.targetEmail ==
          get(
            /databases/$(database)/documents/connections/$(request.resource.data.connectionId)
          ).data.fromEmail;

      // Company follower notifications currently use localStorage for
      // follower relationships, so Firestore cannot securely verify the
      // recipient yet. Keep this temporarily restricted to the post owner.
      allow create: if signedIn() &&
        request.resource.data.type == "followed_company_post" &&
        request.resource.data.postId != null &&
        get(
          /databases/$(database)/documents/posts/$(request.resource.data.postId)
        ).data.ownerUid == request.auth.uid;

      // Admins may create system notifications.
      allow create: if isAdmin();

      // Notifications are recipient-only. Recipients are matched either by
      // their verified token email (legacy/new_application/new_message docs)
      // or by their UID (connection notifications, which never carry a
      // recipient email). targetUid is always bound to the true recipient by
      // the create rules above, so a UID match can never be forged.
      allow read, update, delete: if signedIn() &&
        (
          resource.data.targetUid == request.auth.uid ||
          resource.data.targetEmail == request.auth.token.email ||
          isAdmin()
        );
    }

    match /reports/{reportId} {
      allow create: if signedIn();

      allow read, update, delete: if isAdmin();
    }

    match /savedJobs/{savedJobId} {
      allow create: if signedIn() &&
        request.resource.data.userUid == request.auth.uid;

      allow read, update, delete: if signedIn() &&
        resource.data.userUid == request.auth.uid;
    }

    // Recorded apply clicks. One document per seeker per post, used only
    // to deduplicate clicks; dashboards read the aggregate on the post doc.
    match /applyClicks/{clickId} {
      allow create: if signedIn() &&
        request.resource.data.userUid == request.auth.uid;

      allow read: if signedIn() &&
        (
          resource == null ||
          resource.data.userUid == request.auth.uid
        );

      allow update, delete: if signedIn() &&
        resource.data.userUid == request.auth.uid;
    }

    match /verificationRequests/{requestId} {
  allow create: if signedIn()
    && request.resource.data.uid == request.auth.uid
    && request.resource.data.requestedByEmail == request.auth.token.email
    && request.resource.data.status == "pending";

  allow read: if signedIn()
    && (
      resource.data.uid == request.auth.uid ||
      isAdmin()
    );

  allow update: if isAdmin();

  allow delete: if signedIn()
    && resource.data.uid == request.auth.uid
    && resource.data.status == "pending";
}

    match /posts/{postId} {
      allow read: if true;

      // Post creation. Normal owners may create a post, but moderation,
      // trust, and counter fields must start in the application's safe
      // defaults and can never be chosen by the client.
      allow create: if signedIn() &&
        request.resource.data.ownerUid == request.auth.uid &&
        hasValidExternalApplication(request.resource.data) &&

        // Moderation/trust fields are only ever set by an admin later;
        // clients may only create a post with the safe defaults (featured
        // defaults to false, no approved/suspicious flags yet).
        (
          !request.resource.data.keys().hasAny(["approved"]) ||
          request.resource.data.approved == false
        ) &&
        (
          !request.resource.data.keys().hasAny(["suspicious"]) ||
          request.resource.data.suspicious == false
        ) &&
        (
          !request.resource.data.keys().hasAny(["featured"]) ||
          request.resource.data.featured == false
        ) &&
        request.resource.data.qualityScore is number &&
        request.resource.data.qualityScore >= 0 &&
        request.resource.data.qualityScore <= 100 &&

        // Trust signals must mirror the owner's admin-controlled user doc;
        // a client cannot self-certify a post.
        request.resource.data.verified ==
          (
            get(
              /databases/$(database)/documents/users/$(request.resource.data.ownerUid)
            ).data.verified == true
          ) &&
        request.resource.data.trusted ==
          (
            get(
              /databases/$(database)/documents/users/$(request.resource.data.ownerUid)
            ).data.trusted == true
          ) &&

        // Moderation/status state must start in the safe values the
        // application uses on publish (agency/abroad posts are created
        // closed + pending review by createPost).
        request.resource.data.status in ["active", "closed"] &&
        request.resource.data.reviewStatus in ["approved", "pending"] &&
        request.resource.data.moderationStatus in ["approved", "pending"] &&
        request.resource.data.safetyStatus == "clear" &&

        // Counters must start at zero. applyClicks is created on the first
        // recorded click, so its absence is also valid.
        request.resource.data.views == 0 &&
        request.resource.data.shares == 0 &&
        request.resource.data.saves == 0 &&
        request.resource.data.reports == 0 &&
        request.resource.data.applications == 0 &&
        (
          !request.resource.data.keys().hasAny(["applyClicks"]) ||
          request.resource.data.applyClicks == 0
        );

      allow update: if signedIn() &&
        // Apply-click increments remain limited to non-hiring (seeker)
        // accounts so hiring accounts cannot inflate their own counters.
        (
          !request.resource.data.diff(resource.data)
            .affectedKeys()
            .intersects(["applyClicks"]) ||
          get(
            /databases/$(database)/documents/users/$(request.auth.uid)
          ).data.accountType != "hiring"
        ) &&
        (
          // Admins retain full moderation, verification, trusting,
          // featuring, and quality-score control.
          isAdmin() ||

          // Post owners may edit legitimate content and application fields,
          // but never moderation/trust/featured fields or any counter.
          (
            resource.data.ownerUid == request.auth.uid &&
            !request.resource.data.diff(resource.data)
              .affectedKeys()
              .hasAny([
                "approved",
                "verified",
                "trusted",
                "featured",
                "suspicious",
                "qualityScore",
                "reviewStatus",
                "moderationStatus",
                "safetyStatus",
                "views",
                "shares",
                "applications",
                "saves",
                "reports",
                "applyClicks"
              ]) &&
            // Owners may still open/close their own listing.
            (
              !request.resource.data.diff(resource.data)
                .affectedKeys()
                .hasAny(["status"]) ||
              request.resource.data.status in ["active", "closed"]
            ) &&
            (
              !request.resource.data.diff(resource.data)
                .affectedKeys()
                .hasAny([
                  "applicationMethod",
                  "externalApplicationType",
                  "applicationUrl",
                  "applicationEmail"
                ]) ||
              hasValidExternalApplication(
                request.resource.data
              )
            )
          ) ||

          // Single-counter, single-step increments. Preserves the exact
          // operations the application performs today and blocks arbitrary
          // inflation or reset. The value must move by exactly one step,
          // sharing the write with only updatedAt.
          (
            request.resource.data.diff(resource.data)
              .affectedKeys()
              .hasOnly(["views", "updatedAt"]) &&
            request.resource.data.views == resource.data.views + 1
          ) ||
          (
            request.resource.data.diff(resource.data)
              .affectedKeys()
              .hasOnly(["shares", "updatedAt"]) &&
            request.resource.data.shares == resource.data.shares + 1
          ) ||
          (
            request.resource.data.diff(resource.data)
              .affectedKeys()
              .hasOnly(["applications", "updatedAt"]) &&
            request.resource.data.applications == resource.data.applications + 1
          ) ||
          // saves is the only counter the application also decrements
          // (removeSavedJob passes delta -1).
          (
            request.resource.data.diff(resource.data)
              .affectedKeys()
              .hasOnly(["saves", "updatedAt"]) &&
            (
              request.resource.data.saves == resource.data.saves + 1 ||
              request.resource.data.saves == resource.data.saves - 1
            )
          ) ||
          (
            request.resource.data.diff(resource.data)
              .affectedKeys()
              .hasOnly(["reports", "updatedAt"]) &&
            request.resource.data.reports == resource.data.reports + 1
          ) ||
          (
            request.resource.data.diff(resource.data)
              .affectedKeys()
              .hasOnly(["applyClicks", "updatedAt"]) &&
            request.resource.data.applyClicks ==
              (resource.data.keys().hasAny(["applyClicks"])
                ? resource.data.applyClicks
                : 0) + 1
          )
        );

      allow delete: if signedIn() &&
        (
          resource.data.ownerUid == request.auth.uid ||
          isAdmin()
        );
    }

    match /applications/{applicationId} {
      allow read: if signedIn() &&
        (
          resource.data.seeker.uid == request.auth.uid ||
          resource.data.ownerUid == request.auth.uid ||
          isAdmin()
        );

      allow create: if signedIn() &&
        request.resource.data.seeker.uid == request.auth.uid &&
        request.resource.data.status == "pending" &&
        request.resource.data.ownerUid ==
          get(
            /databases/$(database)/documents/posts/$(request.resource.data.opportunityId)
          ).data.ownerUid &&
        get(
          /databases/$(database)/documents/posts/$(request.resource.data.opportunityId)
        ).data.status == "active" &&
        get(
          /databases/$(database)/documents/posts/$(request.resource.data.opportunityId)
        ).data.reviewStatus == "approved" &&
        get(
          /databases/$(database)/documents/posts/$(request.resource.data.opportunityId)
        ).data.moderationStatus == "approved" &&
        (
          !request.resource.data.keys().hasAny(["applicationMethod"]) ||
          request.resource.data.applicationMethod == "forsa"
        );

      // Seeker-owned external application tracking.
      // Forsa does not control the employer's application system and never
      // claims to know the employer's response. This document only records
      // that the seeker initiated an external application, so it must not
      // carry employer-facing or conversation data.
      allow create: if signedIn() &&
        request.resource.data.seeker.uid == request.auth.uid &&
        request.resource.data.status == "pending" &&
        request.resource.data.applicationMethod == "external" &&
        request.resource.data.trackingStatus in [
          "applied",
          "waiting",
          "interview",
          "offer",
          "rejected",
          "withdrawn"
        ] &&
        hasValidExternalApplication(request.resource.data) &&
        !request.resource.data.keys().hasAny([
          "ownerUid",
          "ownerEmail",
          "conversation",
          "statusHistory",
          "questions",
          "answers",
          "interview"
        ]) &&
        get(
          /databases/$(database)/documents/posts/$(request.resource.data.opportunityId)
        ).data.status == "active" &&
        get(
          /databases/$(database)/documents/posts/$(request.resource.data.opportunityId)
        ).data.reviewStatus == "approved" &&
        get(
          /databases/$(database)/documents/posts/$(request.resource.data.opportunityId)
        ).data.moderationStatus == "approved";

      // Applicants can only update messaging fields.
      allow update: if signedIn() &&
        resource.data.seeker.uid == request.auth.uid &&
        request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly([
            "lastMessage",
            "updatedAt",
            "conversation"
          ]);

      // Seekers can only manage their own external application tracking
      // status. The internal `status` and all application data stay
      // immutable, and an employer can never edit or reply through these
      // records because they carry no owner fields.
      allow update: if signedIn() &&
        resource.data.seeker.uid == request.auth.uid &&
        resource.data.applicationMethod == "external" &&
        request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly([
            "trackingStatus",
            "updatedAt"
          ]) &&
        request.resource.data.trackingStatus in [
          "applied",
          "waiting",
          "interview",
          "offer",
          "rejected",
          "withdrawn"
        ];

      // Hiring users can manage application status/interviews
      // and communicate with the applicant.
      allow update: if signedIn() &&
        resource.data.ownerUid == request.auth.uid &&
        request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly([
            "status",
            "lastMessage",
            "updatedAt",
            "conversation",
            "statusHistory",
            "interview"
          ]);

      // Admins retain full application management access.
      allow update: if isAdmin();

      allow delete: if signedIn() &&
        (
          resource.data.seeker.uid == request.auth.uid ||
          resource.data.ownerUid == request.auth.uid ||
          isAdmin()
        );
    }

    match /outreachLeads/{leadId} {
      allow read, create, update, delete: if isAdmin();
    }

    // Mira AI usage counters — one document per user per UTC day
    // ({uid}_{YYYY-MM-DD}), written only by the Admin SDK from the
    // server-side quota helper, which bypasses rules. Denying all client
    // writes means a user can neither top up their own allowance nor reset
    // anyone else's; reading your own counter is allowed so the UI can show
    // remaining usage.
    match /miraUsage/{usageId} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    // Forsa AI shared daily budget — one document per UTC day, written only
    // by the Admin SDK alongside the personal counter in a single atomic
    // transaction. Fully server-side: clients can neither read aggregate
    // usage nor write it, so the budget cannot be inspected for gaming or
    // modified by any user.
    match /miraUsageGlobal/{day} {
      allow read, write: if false;
    }
  }
}