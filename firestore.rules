rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function verifiedUser() {
      return signedIn() &&
        request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return signedIn() &&
        get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.role == "admin";
    }

    match /users/{userId} {
  allow read: if signedIn();

  allow create: if signedIn() &&
    request.auth.uid == userId &&
    request.resource.data.uid == userId &&
    request.resource.data.emailVerified ==
      request.auth.token.email_verified &&
    (
      !request.resource.data.keys().hasAny(["role"]) ||
      request.resource.data.role != "admin"
    );

  // Normal user profile edits.
  // Protected fields cannot be changed by the user.
  allow update: if signedIn() &&
    request.auth.uid == userId &&
    !request.resource.data.diff(resource.data)
      .affectedKeys()
      .hasAny([
        "uid",
        "role",
        "accountType",
        "trusted",
        "verified",
        "emailVerified",
        "createdAt"
      ]);

  // User is allowed to synchronize email verification
  // after Firebase Auth confirms the email.
  allow update: if signedIn() &&
    request.auth.uid == userId &&
    request.resource.data.emailVerified == true &&
    request.auth.token.email_verified == true &&
    request.resource.data.diff(resource.data)
      .affectedKeys()
      .hasOnly([
        "emailVerified",
        "updatedAt"
      ]);

  // Admin can update the user.
  allow update: if isAdmin();

  allow delete: if signedIn() &&
    request.auth.uid == userId;
}

    match /connections/{connectionId} {
      allow read: if signedIn();

      allow create: if signedIn() &&
        request.resource.data.fromUid == request.auth.uid;

      allow update: if signedIn() &&
        resource.data.toUid == request.auth.uid;

      allow delete: if signedIn() &&
        (
          resource.data.fromUid == request.auth.uid ||
          resource.data.toUid == request.auth.uid ||
          isAdmin()
        );
    }

    match /notifications/{notificationId} {
      allow create: if signedIn();

      allow read, update, delete: if signedIn() &&
        (
          resource.data.targetEmail == request.auth.token.email ||
          isAdmin()
        );
    }

    match /reports/{reportId} {
      allow create: if signedIn();

      allow read, update, delete: if isAdmin();
    }

    match /savedJobs/{savedJobId} {
      allow create: if signedIn() &&
        request.resource.data.userUid == request.auth.uid;

      allow read, update, delete: if signedIn() &&
        resource.data.userUid == request.auth.uid;
    }

    match /verificationRequests/{requestId} {
  allow create: if signedIn()
    && request.resource.data.uid == request.auth.uid
    && request.resource.data.requestedByEmail == request.auth.token.email
    && request.resource.data.status == "pending";

  allow read: if signedIn()
    && (
      resource.data.uid == request.auth.uid ||
      isAdmin()
    );

  allow update: if isAdmin();

  allow delete: if signedIn()
    && resource.data.uid == request.auth.uid
    && resource.data.status == "pending";
}

    match /posts/{postId} {
      allow read: if true;

      allow create: if signedIn() &&
        request.resource.data.ownerUid == request.auth.uid;

      allow update: if signedIn() &&
        (
          resource.data.ownerUid == request.auth.uid ||
          isAdmin() ||

          request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasOnly(["views", "updatedAt"]) ||

          request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasOnly(["shares", "updatedAt"]) ||

          request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasOnly(["applications", "updatedAt"]) ||

          request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasOnly(["saves", "updatedAt"]) ||

          request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasOnly(["reports", "updatedAt"])
        );

      allow delete: if signedIn() &&
        (
          resource.data.ownerUid == request.auth.uid ||
          isAdmin()
        );
    }

    match /applications/{applicationId} {
      allow read: if signedIn() &&
        (
          resource.data.seeker.uid == request.auth.uid ||
          resource.data.ownerUid == request.auth.uid ||
          isAdmin()
        );

      allow create: if signedIn() &&
        request.resource.data.seeker.uid == request.auth.uid &&
        request.resource.data.status == "pending";

      allow update: if signedIn() &&
        (
          resource.data.seeker.uid == request.auth.uid ||
          resource.data.ownerUid == request.auth.uid ||
          isAdmin()
        );

      allow delete: if signedIn() &&
        (
          resource.data.seeker.uid == request.auth.uid ||
          resource.data.ownerUid == request.auth.uid ||
          isAdmin()
        );
    }

    match /outreachLeads/{leadId} {
      allow read, create, update, delete: if signedIn() &&
        request.auth.token.email == "support.forsa@gmail.com";
    }
  }
}